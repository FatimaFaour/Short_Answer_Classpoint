Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\shortanswer]
@="URL:Short Answer Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\shortanswer\DefaultIcon]
@="\"FULL_PATH_TO_PROJECT\\teacher\\ShortAnswerTeacher.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\shortanswer\shell\open\command]
@="\"FULL_PATH_TO_PROJECT\\teacher\\ShortAnswerTeacher.exe\" \"%1\""

; --- Python (dev) option: replace the command above with pythonw.exe + script path ---
; [HKEY_CURRENT_USER\Software\Classes\shortanswer\shell\open\command]
